# ============================================
# WHISPER MART — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to Git.
# ============================================

# ---------- Database ----------
POSTGRES_USER=whisper
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=whisper_mart
DATABASE_URL=postgresql://whisper:change-this-strong-password@postgres:5432/whisper_mart

# ---------- Backend / Auth ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
ENV=production
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Comma-separated list of allowed frontend origins. Required (no "*") when ENV=production.
CORS_ORIGINS=http://localhost:3000,https://whisper-selling.xyz
# Comma-separated list of hostnames this API will accept requests for. "*" disables the check (fine for local dev).
ALLOWED_HOSTS=*

# Rate limits for brute-force-sensitive endpoints (slowapi syntax, e.g. "10/minute")
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHECKOUT=20/minute
RATE_LIMIT_DEFAULT=120/minute

# ---------- Payments ----------
# PAYMENT_PROVIDER=mock uses a safe, no-external-credentials test mode.
# Set to "razorpay" and fill in real keys below to accept real payments.
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks, needed to verify async payment confirmations.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Worker processes (production Docker image) ----------
GUNICORN_WORKERS=4

# ---------- File Storage ----------
# local | cloudinary | s3 | r2
STORAGE_BACKEND=local
# Uncomment and fill if using Cloudinary:
# CLOUDINARY_URL=
# Uncomment and fill if using S3 / Cloudflare R2:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=
# AWS_ENDPOINT_URL=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
